<%- include('partials/top') %>
<%- include('partials/settings-head') %>
<section class="card settings-card">
  <h2>Alterar minha senha</h2>
  <% if (error) { %><p class="alert" role="alert"><%= error %></p><% } %>
  <form class="form-grid" method="post" action="/perfil/senha">
    <label for="current_password">Senha atual</label>
    <input id="current_password" name="current_password" type="password" autocomplete="current-password" required>
    <label for="new_password">Nova senha (mín. 8 caracteres)</label>
    <input id="new_password" name="new_password" type="password" autocomplete="new-password" minlength="8" required>
    <label for="confirm_password">Confirmar nova senha</label>
    <input id="confirm_password" name="confirm_password" type="password" autocomplete="new-password" minlength="8" required>
    <div class="form-actions"><button class="primary" type="submit">Salvar senha</button></div>
  </form>
</section>
<%- include('partials/bottom') %>
