<%- include('partials/top', { bodyClass: 'approval-page', t: t }) %>
<div class="approval-screen">
  <div class="approval-layout">
    <div class="approval-content">
      <header class="approval-topbar">
        <div class="approval-brand">
          <img src="/static/logo-fuel.svg" alt="Fuel Jobs" width="615" height="281">
        </div>
        <span class="approval-topbar-tag"><%= t.topbarTag %></span>
      </header>

      <div class="approval-scroll" tabindex="0" role="region" aria-label="<%= t.regionLabel %>">
        <article class="approval-hero" aria-labelledby="job-title">
          <p class="approval-kicker"><span class="approval-client"><%= job.client_name %></span></p>
          <h1 class="approval-title" id="job-title"><%= job.title %></h1>

          <ul class="approval-facts" aria-label="<%= t.factsLabel %>">
            <li class="approval-fact">
              <span class="approval-fact-label"><%= t.stage %></span>
              <span class="approval-fact-value"><%= t.statusName(job.status) %></span>
            </li>
            <li class="approval-fact">
              <span class="approval-fact-label"><%= t.priority %></span>
              <span class="approval-fact-value priority-<%= PRIORITY_SLUG[job.priority] %>"><%= t.priorityName(job.priority) %></span>
            </li>
            <% if (job.due_date) { %>
              <li class="approval-fact">
                <span class="approval-fact-label"><%= t.dueDate %></span>
                <span class="approval-fact-value"><%= t.fmtDate(job.due_date) %></span>
              </li>
            <% } %>
          </ul>

          <p class="approval-byline">
            <%= t.responsible %>: <%= job.responsible_name || t.noResponsible %><span aria-hidden="true">·</span><%= t.createdAt %> <%= t.fmtDateTime(job.created_at) %>
          </p>
        </article>

        <section class="approval-report" aria-labelledby="report-title">
          <h2 class="approval-label" id="report-title"><%= t.report %></h2>
          <p class="approval-description"><%= job.description %></p>
        </section>

        <section class="approval-section" aria-labelledby="attachments-title">
          <div class="approval-section-head">
            <h2 class="approval-label" id="attachments-title"><%= t.attachments %></h2>
            <% if (attachments.length) { %>
              <span class="approval-count"><%= t.files(attachments.length) %></span>
            <% } %>
          </div>

          <% if (job.dropbox_url && /^https?:\/\//i.test(job.dropbox_url)) { %>
            <div class="attachment">
              <div class="attachment-info">
                <strong>Dropbox</strong>
                <a href="<%= job.dropbox_url %>" target="_blank" rel="noopener noreferrer"><%= t.openDropbox %></a>
              </div>
            </div>
          <% } %>

          <div class="attachment-gallery">
            <% attachments.forEach(function (a) { %>
              <%
                const previewKind = PREVIEW_MIME.has(a.mime_type)
                  ? a.mime_type.startsWith('image/')
                    ? 'image'
                    : a.mime_type === 'application/pdf'
                      ? 'pdf'
                      : 'text'
                  : null;
                const extension = (a.original_name.split('.').pop() || 'arquivo').toUpperCase();
                const previewUrl = `/aprovacao/${job.approval_token}/anexo/${a.id}/preview${langQuery}`;
              %>
              <figure class="attachment-card">
                <div class="attachment-preview">
                  <% if (previewKind === 'image') { %>
                    <button class="attachment-image" type="button"
                            data-preview-url="<%= previewUrl %>"
                            data-preview-kind="image"
                            data-preview-name="<%= a.original_name %>"
                            aria-label="<%= t.enlarge(a.original_name) %>">
                      <img src="<%= previewUrl %>" alt="<%= t.attachmentAlt(a.original_name) %>" loading="lazy">
                    </button>
                  <% } else if (previewKind === 'pdf') { %>
                    <iframe class="attachment-frame" src="<%= previewUrl %>#toolbar=0&navpanes=0&view=FitH"
                            title="<%= t.previewOf(a.original_name) %>" loading="lazy"></iframe>
                  <% } else if (previewKind === 'text') { %>
                    <iframe class="attachment-frame attachment-frame--text" src="<%= previewUrl %>"
                            title="<%= t.previewOf(a.original_name) %>" loading="lazy"></iframe>
                  <% } else { %>
                    <span class="attachment-file" aria-hidden="true">
                      <span class="attachment-file-ext"><%= extension %></span>
                    </span>
                  <% } %>
                </div>
                <figcaption class="attachment-meta">
                  <span class="attachment-name is-file"><%= a.original_name %></span>
                  <span class="muted small">
                    <%= t.by %> <%= a.user_name %> · <%= a.size %> <%= t.bytes %><% if (!previewKind) { %> · <%= t.noPreview %><% } %>
                  </span>
                </figcaption>
              </figure>
            <% }); %>
          </div>

          <% if (attachments.length === 0 && !job.dropbox_url) { %>
            <p class="approval-empty"><%= t.noAttachments %></p>
          <% } %>
        </section>

        <section class="approval-section" aria-labelledby="comments-title">
          <div class="approval-section-head">
            <h2 class="approval-label" id="comments-title"><%= t.comments %></h2>
            <% if (comments.length) { %>
              <span class="approval-count"><%= comments.length %></span>
            <% } %>
          </div>

          <% if (comments.length === 0) { %>
            <p class="approval-empty"><%= t.noComments %></p>
          <% } else { %>
            <div class="approval-comments">
              <% comments.forEach(function (c) { %>
                <article class="comment">
                  <div class="comment-head">
                    <strong><%= c.user_name %></strong>
                    <span class="muted small"><%= t.fmtDateTime(c.created_at) %><% if (c.edited_at) { %> · <%= t.editedAt %> <%= t.fmtDateTime(c.edited_at) %><% } %></span>
                  </div>
                  <p><%= c.body %></p>
                </article>
              <% }); %>
            </div>
          <% } %>
        </section>

        <section class="approval-timeline" aria-labelledby="timeline-title">
          <h2 class="approval-label" id="timeline-title"><%= t.timeline %></h2>
          <ol class="report-timeline">
            <li class="timeline-item"><span class="timeline-when"><%= t.fmtDateTime(job.created_at) %></span><span><%= t.tlCreated %></span></li>
            <% if (job.admin_approved_at) { %>
              <li class="timeline-item"><span class="timeline-when"><%= t.fmtDateTime(job.admin_approved_at) %></span><span><%= t.tlAdminApproved %></span></li>
            <% } %>
            <% if (job.client_approved_at) { %>
              <li class="timeline-item"><span class="timeline-when"><%= t.fmtDateTime(job.client_approved_at) %></span><span><%= t.tlClientApproved %></span></li>
            <% } %>
            <% if (job.client_rejected_at) { %>
              <li class="timeline-item"><span class="timeline-when"><%= t.fmtDateTime(job.client_rejected_at) %></span><span><%= t.tlClientRejected %>: <%= job.client_rejection_reason %></span></li>
            <% } %>
            <% if (job.completed_at) { %>
              <li class="timeline-item"><span class="timeline-when"><%= t.fmtDateTime(job.completed_at) %></span><span><%= t.tlCompleted %></span></li>
            <% } %>
          </ol>
        </section>
      </div>
    </div>

    <aside class="approval-aside" aria-labelledby="decision-title">
      <section class="approval-decision<%= result || job.status !== 'Aprovação' ? ' is-result' : '' %>" data-decision-card>
        <span class="approval-card-spotlight" aria-hidden="true"></span>
        <span class="approval-decision-kicker">
          <% if (!result && job.status === 'Aprovação') { %><span class="approval-live" aria-hidden="true"></span><% } %>
          <%= t.yourDecision %>
        </span>
        <h2 id="decision-title">
          <% if (result === 'approved') { %><%= t.titleApproved %>
          <% } else if (result === 'rejected') { %><%= t.titleRejected %>
          <% } else if (job.status !== 'Aprovação') { %><%= t.titleIdle %>
          <% } else { %><%= t.titleAsk %><% } %>
        </h2>

        <% if (error) { %><p class="alert" role="alert"><%= error %></p><% } %>

        <% if (result === 'approved') { %>
          <div class="approval-state">
            <span class="approval-emblem" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
            </span>
            <p class="approval-result" role="status"><%= t.resultApproved %></p>
          </div>
        <% } else if (result === 'rejected') { %>
          <div class="approval-state">
            <span class="approval-emblem is-rejected" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
            </span>
            <p class="approval-result" role="status"><%= t.resultRejected %></p>
            <% if (job.client_rejection_reason) { %>
              <blockquote class="approval-quoted"><%= job.client_rejection_reason %></blockquote>
            <% } %>
          </div>
        <% } else if (job.status !== 'Aprovação') { %>
          <div class="approval-state">
            <span class="approval-emblem is-idle" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
            </span>
            <p class="approval-result" role="status"><%= t.resultIdle %></p>
            <span class="approval-chip"><%= t.currentStage %>: <%= t.statusName(job.status) %></span>
          </div>
        <% } else { %>
          <p><%= t.reviewHint %></p>

          <form method="post" action="/aprovacao/<%= job.approval_token %>/aprovar<%= langQuery %>" data-approve-form
                data-label-confirm="<%= t.confirmApprove %>" data-label-busy="<%= t.approving %>">
            <div data-approve-step="ask">
              <button class="button approval-approve" type="button" data-approve-start>
                <span class="approval-btn-label"><%= t.approve %></span><span class="approval-approve-arrow" aria-hidden="true">→</span>
              </button>
            </div>
            <div class="approval-confirm-step" data-approve-step="confirm" hidden>
              <p class="approval-confirm-title"><%= t.confirmTitle %></p>
              <p class="approval-confirm-hint"><%= t.confirmHint %></p>
              <button class="button approval-approve approval-confirm" type="submit" data-approve-confirm>
                <span class="approval-confirm-check" aria-hidden="true">✓</span><span class="approval-btn-label approval-confirm-label"><%= t.confirmApprove %></span>
              </button>
              <button class="button ghost approval-approve-cancel" type="button" data-approve-cancel><%= t.cancel %></button>
            </div>
          </form>

          <div class="approval-divider" aria-hidden="true"><span><%= t.or %></span></div>

          <button class="button ghost approval-reject-toggle" type="button"
                  data-reveal="reject-panel" aria-expanded="<%= error ? 'true' : 'false' %>" aria-controls="reject-panel">
            <%= t.reject %>
          </button>

          <form method="post" action="/aprovacao/<%= job.approval_token %>/rejeitar<%= langQuery %>"
                id="reject-panel" class="reject-panel"<%= error ? '' : ' hidden' %>>
            <label for="reason"><%= t.rejectReason %></label>
            <textarea id="reason" name="reason" maxlength="2000" required
                      placeholder="<%= t.rejectPlaceholder %>"></textarea>
            <div class="reject-actions">
              <button class="button danger" type="submit"><%= t.confirmReject %></button>
              <button class="button ghost" type="button" data-dismiss-reveal="reject-panel"><%= t.cancel %></button>
            </div>
          </form>
        <% } %>
      </section>
    </aside>
  </div>
</div>
<%- include('partials/bottom', { bodyClass: 'approval-page', t: t }) %>
