<%- include('partials/top') %>
<%- include('partials/settings-head') %>

<% if (notice) { %><p class="alert ok" role="status">Perfil atualizado com sucesso.</p><% } %>
<% if (error) { %><p class="alert" role="alert"><%= error %></p><% } %>

<div class="profile-grid">
  <section class="card profile-card">
    <div class="profile-head">
      <% if (user.avatar) { %>
        <img class="avatar profile-avatar" src="<%= avatarUrl(user.avatar) %>" alt="Foto de <%= user.name %>">
      <% } else { %>
        <span class="avatar profile-avatar av-<%= user.id % 6 %>" aria-hidden="true"><%= initials(user.name) %></span>
      <% } %>
      <div class="profile-identity">
        <h2><%= user.name %></h2>
        <p class="muted"><%= user.email %> · <%= user.role === 'admin' ? 'Administrador' : 'Usuário' %></p>
      </div>
    </div>

    <form class="form-grid" method="post" action="/perfil">
      <label for="name">Nome na conta</label>
      <input id="name" name="name" value="<%= user.name %>" maxlength="120" required autocomplete="name">
      <div class="form-actions"><button class="primary" type="submit">Salvar nome</button></div>
    </form>
  </section>

  <section class="card profile-card">
    <h2>Foto de perfil</h2>
    <p class="muted small">PNG, JPG ou WebP, até 3 MB. A foto aparece na sidebar e no seu perfil.</p>
    <form class="form-grid" method="post" action="/perfil/foto" enctype="multipart/form-data">
      <label for="photo">Escolher foto</label>
      <input id="photo" name="photo" type="file" accept="image/png,image/jpeg,image/webp" required>
      <div class="form-actions"><button class="primary" type="submit">Enviar foto</button></div>
    </form>
    <% if (user.avatar) { %>
      <form method="post" action="/perfil/foto/remover" data-confirm="Remover sua foto de perfil?">
        <button class="button ghost" type="submit">Remover foto</button>
      </form>
    <% } %>
  </section>
</div>

<%- include('partials/bottom') %>
