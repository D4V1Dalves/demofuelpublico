<%- include('partials/top') %>
<div class="page-head"><a class="back-link" href="/dashboard">Dashboard</a><% if (user.role === 'admin') { %><a class="button secondary" href="/requisicoes/<%= request.id %>/editar">Editar</a><% } %></div>

<section class="card detail-head" data-status="<%= request.status %>">
  <% if (canTime) { %>
    <div class="detail-timer-actions" role="group" aria-label="Controle de tempo do job">
      <% if (!timer || timer.status === 'finished') { %>
        <form method="post" action="/requisicoes/<%= request.id %>/timer/iniciar">
          <button class="timer-icon-button is-start" type="submit"
                  aria-label="<%= timer ? 'Retomar job' : 'Iniciar job' %>"
                  title="<%= timer ? 'Retomar job' : 'Iniciar job' %>">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M8 5v14l11-7z"/></svg>
          </button>
        </form>
      <% } else if (timer.status === 'running') { %>
        <form method="post" action="/requisicoes/<%= request.id %>/timer/pausar">
          <button class="timer-icon-button is-pause" type="submit" aria-label="Pausar job" title="Pausar job">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M7 5h4v14H7zM13 5h4v14h-4z"/></svg>
          </button>
        </form>
        <form method="post" action="/requisicoes/<%= request.id %>/timer/concluir"
              <% if (!hasProgressNote) { %>data-conclude-blocked data-relato-url="/requisicoes/<%= request.id %>/relato"<% } %>>
          <button class="timer-icon-button is-done" type="submit" aria-label="Concluir job" title="Concluir job">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4z"/></svg>
          </button>
        </form>
      <% } else { %>
        <form method="post" action="/requisicoes/<%= request.id %>/timer/retomar">
          <button class="timer-icon-button is-start" type="submit" aria-label="Retomar job" title="Retomar job">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M8 5v14l11-7z"/></svg>
          </button>
        </form>
        <form method="post" action="/requisicoes/<%= request.id %>/timer/concluir"
              <% if (!hasProgressNote) { %>data-conclude-blocked data-relato-url="/requisicoes/<%= request.id %>/relato"<% } %>>
          <button class="timer-icon-button is-done" type="submit" aria-label="Concluir job" title="Concluir job">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4z"/></svg>
          </button>
        </form>
      <% } %>
    </div>
  <% } %>

  <% if (error && error !== concludeRequiredMessage) { %><p class="alert" role="alert"><%= error %></p><% } %>
  <p class="alert" role="alert" id="conclude-required" <%= error === concludeRequiredMessage ? '' : 'hidden' %>><%= concludeRequiredMessage %></p>
  <span class="client detail-kicker"><%= request.client_name %></span>
  <h1 class="detail-title"><%= request.title %></h1>
  <div class="badges">
    <span class="badge"><%= request.status %></span>
    <span class="badge priority-<%= PRIORITY_SLUG[request.priority] %>"><%= request.priority %></span>
    <% if (request.due_date) { %><span class="badge <%= request.due_date < today && request.status !== 'Aprovado' && request.status !== 'Rejeitado' ? 'late' : '' %>">Prazo: <%= fmtDate(request.due_date) %></span><% } %>
  </div>
  <p class="muted">Responsável: <%= request.responsible_name || 'Sem responsável' %> · Criada em <%= fmtDateTime(request.created_at) %></p>
  <p><%= request.description %></p>

  <% if (user.role === 'admin' && request.status === 'Em processo') { %>
    <form method="post" action="/requisicoes/<%= request.id %>/aprovar" class="inline">
      <button class="button" type="submit">Aprovar e enviar ao cliente</button>
    </form>
  <% } %>
  <p class="flow-hint">
    <% if (request.status === 'Novo') { %>
      Aguardando a equipe iniciar o job.
    <% } else if (request.status === 'Em andamento') { %>
      Equipe trabalhando — ao concluir o timer, o job vai para a revisão do administrador.
    <% } else if (request.status === 'Em processo') { %>
      A equipe concluiu. O administrador revisa e envia ao cliente.
    <% } else if (request.status === 'Aprovação') { %>
      Aguardando a decisão do cliente no link de aprovação.
    <% } else if (request.status === 'Aprovado') { %>
      Job aprovado pelo cliente e concluído.
    <% } else { %>
      Rejeitado pelo cliente — volte o job para Em andamento, ajuste e conclua de novo para reenviar.
    <% } %>
  </p>
  <% if (user.role === 'admin' && approvalUrl) { %>
    <div class="approval-link">
      <label for="approval-link-input">Link de aprovação em português</label>
      <div class="copy-field">
        <input id="approval-link-input" type="text" readonly value="<%= approvalUrl %>">
        <button class="button secondary" type="button" data-copy-target="#approval-link-input">Copiar link</button>
      </div>
      <label for="approval-link-input-en">Link de aprovação em inglês</label>
      <div class="copy-field">
        <input id="approval-link-input-en" type="text" readonly value="<%= approvalUrlEn %>">
        <button class="button secondary" type="button" data-copy-target="#approval-link-input-en">Copiar link</button>
      </div>
      <p class="form-hint">Envie ao cliente o link no idioma dele. Os dois abrem a tela de aprovação sem exigir login; no link em inglês, só a interface muda — relatório e comentários aparecem como foram escritos.</p>
    </div>
  <% } %>
  <% if (request.client_approved_at) { %>
    <p class="muted small">Aprovado pelo cliente em <%= fmtDateTime(request.client_approved_at) %></p>
  <% } %>
  <% if (request.client_rejection_reason) { %>
    <p class="alert" role="alert"><%= request.status === 'Rejeitado' ? 'Rejeitado pelo cliente' : 'Ajustes pedidos pelo cliente' %>: <%= request.client_rejection_reason %></p>
  <% } %>
</section>

<%- include('partials/timer') %>

<% var inProgress = request.status === 'Em andamento'; %>
<div class="detail-grid">
  <section class="card">
    <h2><%= inProgress ? 'O que está sendo feito?' : 'Comentários' %></h2>
    <% comments.forEach(function (c) { %>
      <article class="comment">
        <div class="comment-head">
          <strong><%= c.user_name %></strong>
          <span class="muted small"><%= fmtDateTime(c.created_at) %><% if (c.edited_at) { %> · editado em <%= fmtDateTime(c.edited_at) %><% } %></span>
        </div>
        <p><%= c.body %></p>
        <% if (canEditComments) { %>
          <details class="comment-edit">
            <summary>Editar comentário</summary>
            <form method="post" action="/requisicoes/<%= request.id %>/comentarios/<%= c.id %>/editar" class="stack-form">
              <label for="comment-<%= c.id %>">Novo texto</label>
              <textarea id="comment-<%= c.id %>" name="body" maxlength="20000" required><%= c.body %></textarea>
              <button class="button secondary" type="submit">Salvar comentário</button>
            </form>
          </details>
        <% } %>
      </article>
    <% }); %>
    <% if (comments.length === 0) { %><p class="muted"><%= inProgress ? 'Nenhuma atualização registrada ainda.' : 'Nenhum comentário ainda.' %></p><% } %>
    <% if (!canEditComments && user.role === 'admin' && comments.length > 0) { %>
      <p class="form-hint">Comentários ficam bloqueados fora da etapa <strong>Em processo</strong>.</p>
    <% } %>

    <form method="post" action="/requisicoes/<%= request.id %>/comentarios" class="stack-form">
      <label for="body"><%= inProgress ? 'O que está sendo feito?' : 'Novo comentário' %></label>
      <textarea id="body" name="body" maxlength="20000" required
                <% if (inProgress) { %>placeholder="Conte o andamento: o que você está fazendo agora neste job."<% } %>></textarea>
      <button class="primary" type="submit"><%= inProgress ? 'Registrar andamento' : 'Comentar' %></button>
    </form>
  </section>

  <section class="card" id="suggestions-panel">
    <h2>Sugestões</h2>
    <p class="muted small">Trechos reaproveitáveis de jobs similares anteriores.</p>
    <button class="button secondary" id="generate-suggestions" type="button" data-job-id="<%= request.id %>">Gerar sugestões</button>
    <div id="suggestions-list"></div>
  </section>

  <section class="card" id="attachments">
    <h2>Anexos</h2>
    <% if (request.dropbox_url) { %>
      <div class="attachment">
        <div class="attachment-info">
          <strong>Dropbox</strong><br>
          <a href="<%= request.dropbox_url %>" target="_blank" rel="noopener noreferrer">Abrir pasta no Dropbox</a>
        </div>
      </div>
    <% } %>
    <div class="attachment-gallery">
      <% attachments.forEach(function (a) { %>
        <%
          const previewKind = PREVIEW_MIME.has(a.mime_type)
            ? a.mime_type.startsWith('image/')
              ? 'image'
              : a.mime_type === 'application/pdf'
                ? 'pdf'
                : 'text'
            : null;
          const extension = (a.original_name.split('.').pop() || 'arquivo').toUpperCase();
        %>
        <figure class="attachment-card">
          <div class="attachment-preview">
            <% if (previewKind === 'image') { %>
              <button class="attachment-image" type="button"
                      data-preview-url="/anexos/<%= a.id %>/preview"
                      data-preview-kind="image"
                      data-preview-name="<%= a.original_name %>"
                      aria-label="Ampliar <%= a.original_name %>">
                <img src="/anexos/<%= a.id %>/preview" alt="Anexo: <%= a.original_name %>" loading="lazy">
              </button>
            <% } else if (previewKind === 'pdf') { %>
              <iframe class="attachment-frame" src="/anexos/<%= a.id %>/preview#toolbar=0&navpanes=0&view=FitH"
                      title="Pré-visualização de <%= a.original_name %>" loading="lazy"></iframe>
            <% } else if (previewKind === 'text') { %>
              <iframe class="attachment-frame attachment-frame--text" src="/anexos/<%= a.id %>/preview"
                      title="Pré-visualização de <%= a.original_name %>" loading="lazy"></iframe>
            <% } else { %>
              <span class="attachment-file" aria-hidden="true">
                <span class="attachment-file-ext"><%= extension %></span>
              </span>
            <% } %>
          </div>
          <figcaption class="attachment-meta">
            <span class="attachment-name is-file"><%= a.original_name %></span>
            <span class="muted small">
              por <%= a.user_name %> · <%= a.size %> bytes<% if (!previewKind) { %> · visualização não disponível<% } %>
            </span>
          </figcaption>
        </figure>
      <% }); %>
    </div>
    <% if (attachments.length === 0) { %><p class="muted">Nenhum anexo ainda.</p><% } %>

    <form method="post" action="/requisicoes/<%= request.id %>/anexos" enctype="multipart/form-data"
          class="attachment-upload" data-dropzone>
      <label class="dropzone" for="file">
        <span class="dropzone-glyph" aria-hidden="true">⇪</span>
        <span class="dropzone-title">Arraste o arquivo aqui</span>
        <span class="dropzone-hint">ou clique para escolher · PDF, PNG, JPG, DOCX, XLSX, TXT · até 10 MB</span>
        <input id="file" name="file" type="file" required>
        <span class="dropzone-file" data-dropzone-file hidden></span>
      </label>
      <button class="primary" type="submit">Enviar anexo</button>
    </form>
  </section>
</div>

<script src="/static/suggestions.js" defer></script>
<%- include('partials/bottom') %>
