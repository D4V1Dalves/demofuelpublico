<%- include('partials/top') %>
<%
  const v = current || {};
  const isEdit = Boolean(v.id);
  const action = isEdit ? '/requisicoes/' + v.id + '/editar' : '/requisicoes';
%>
<div class="page-head"><h1 class="page-title"><%= isEdit ? 'Editar requisição' : 'Nova requisição' %></h1><a class="back-link" href="/dashboard">Dashboard</a></div>

<form class="card form-grid" method="post" action="<%= action %>">
  <% if (error) { %><p class="alert" role="alert"><%= error %></p><% } %>

  <label for="title">Título</label>
  <input id="title" name="title" value="<%= v.title || '' %>" required autofocus>

  <label for="client_id">Cliente</label>
  <select id="client_id" name="client_id"<%= isEdit ? ' required' : '' %>>
    <option value="">Selecione…</option>
    <% clients.forEach(function (c) { %>
      <option value="<%= c.id %>" <%= String(v.client_id) === String(c.id) ? 'selected' : '' %>><%= c.name %></option>
    <% }); %>
  </select>

  <% if (!isEdit) { %>
    <label for="new_client_name">Ou novo cliente</label>
    <input id="new_client_name" name="new_client_name" maxlength="120"
           placeholder="Nome do cliente (entra na barra lateral)" value="<%= v.new_client_name || '' %>">
    <p class="form-hint">Se preencher o nome, o cliente é criado e vinculado ao job automaticamente.</p>
  <% } %>

  <label for="description">Descrição</label>
  <textarea id="description" name="description" maxlength="20000"><%= v.description || '' %></textarea>

  <label for="status">Status</label>
  <select id="status" name="status">
    <% STATUSES.forEach(function (s) { %>
      <option value="<%= s %>" <%= v.status === s ? 'selected' : '' %>><%= s %></option>
    <% }); %>
  </select>

  <label for="priority">Prioridade</label>
  <select id="priority" name="priority">
    <% PRIORITIES.forEach(function (p) { %>
      <option value="<%= p %>" <%= v.priority === p ? 'selected' : '' %>><%= p %></option>
    <% }); %>
  </select>

  <label for="responsible_id">Responsável</label>
  <select id="responsible_id" name="responsible_id">
    <option value="">Sem responsável</option>
    <% users.forEach(function (u) { %>
      <option value="<%= u.id %>" <%= String(v.responsible_id || '') === String(u.id) ? 'selected' : '' %>><%= u.name %></option>
    <% }); %>
  </select>

  <label for="due_date">Prazo</label>
  <input id="due_date" name="due_date" type="date" value="<%= v.due_date || '' %>">

  <label for="dropbox_url">Link Dropbox (opcional)</label>
  <input id="dropbox_url" name="dropbox_url" type="url" placeholder="https://www.dropbox.com/s/..." value="<%= v.dropbox_url || '' %>">

  <div class="form-actions"><button class="primary" type="submit">Salvar</button></div>
</form>
<%- include('partials/bottom') %>
