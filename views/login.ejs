<%- include('partials/top', { bodyClass: 'login-page' }) %>
<div class="auth-shell">
  <section class="auth-brand" aria-label="Sobre o Fuel Jobs">
    <a class="brand brand-mark" href="/login" aria-label="Fuel Jobs">
      <img class="brand-logo" src="/static/logo-fuel.svg" alt="Fuel Jobs" width="615" height="281">
    </a>
    <div class="auth-copy">
      <p class="auth-kicker">Workspace de jobs</p>
      <h1>Um board para cada job do seu cliente.</h1>
      <p>Etapas, prazos, responsáveis, aprovação do cliente e relatórios no mesmo lugar — sem planilha paralela.</p>
    </div>
    <ul class="auth-points">
      <li>Quadro por etapa com arrastar e soltar</li>
      <li>Aprovação do cliente por link público</li>
      <li>Agendamentos recorrentes e relatórios</li>
    </ul>
    <span class="hero-wordmark" aria-hidden="true">FUEL</span>
  </section>

  <section class="auth-panel">
    <form class="auth-card" method="post" action="/login">
      <h1>Entrar</h1>
      <p class="muted">Administrador e usuário usam o mesmo acesso.</p>

      <div class="role-switch" role="tablist" aria-label="Tipo de acesso">
        <button class="role-tab is-active" type="button" role="tab" aria-selected="true" data-role-tab="admin">Administrador</button>
        <button class="role-tab" type="button" role="tab" aria-selected="false" data-role-tab="user">Usuário</button>
      </div>
      <p class="role-hint" data-role-hint aria-live="polite">Cria e edita jobs, move etapas, gerencia clientes, agendamentos e usuários.</p>

      <% if (error) { %>
        <p class="alert" role="alert"><%= error %></p>
      <% } %>

      <label for="email">E-mail</label>
      <input id="email" name="email" type="email" autocomplete="username" required autofocus>

      <label for="password">Senha</label>
      <input id="password" name="password" type="password" autocomplete="current-password" required>

      <button class="primary" type="submit">Entrar</button>

      <p class="auth-note">O perfil vem do usuário cadastrado. A escolha acima é apenas uma referência de acesso — quem define as permissões é a conta.</p>
    </form>
  </section>
</div>
<%- include('partials/bottom') %>
