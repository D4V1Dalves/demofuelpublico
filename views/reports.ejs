<%- include('partials/top') %>
<%
  const f = report.filters;
  const presets = [
    { key: 'hoje', label: 'Hoje' },
    { key: '7dias', label: '7 dias' },
    { key: '30dias', label: '30 dias' },
    { key: 'mes', label: 'Mês atual' },
    { key: 'ano', label: 'Ano atual' },
  ];
%>
<div class="page-head">
  <div class="head-center">
    <h1 class="page-title">Relatórios</h1>
    <p class="muted">Jobs abertos, concluídos e rejeitados no período selecionado.</p>
  </div>
</div>

<form class="card filters report-filters" method="get" action="/relatorios">
  <div class="filter-field">
    <label for="granularidade">Agrupar por</label>
    <select id="granularidade" name="granularidade">
      <% granularidades.forEach(function (g) { %>
        <option value="<%= g %>" <%= f.granularidade === g ? 'selected' : '' %>><%= g === 'dia' ? 'Dia' : g === 'semana' ? 'Semana' : g === 'mes' ? 'Mês' : 'Ano' %></option>
      <% }); %>
    </select>
  </div>
  <div class="filter-field">
    <label for="de">De</label>
    <input id="de" name="de" type="date" value="<%= f.de %>" required>
  </div>
  <div class="filter-field">
    <label for="ate">Até</label>
    <input id="ate" name="ate" type="date" value="<%= f.ate %>" required>
  </div>
  <div class="filter-field">
    <label for="cliente">Cliente</label>
    <select id="cliente" name="cliente">
      <option value="">Todos</option>
      <% clients.forEach(function (c) { %>
        <option value="<%= c.id %>" <%= String(f.cliente || '') === String(c.id) ? 'selected' : '' %>><%= c.name %></option>
      <% }); %>
    </select>
  </div>
  <button class="primary" type="submit">Filtrar</button>
</form>

<div class="preset-row">
  <span class="muted small">Atalhos:</span>
  <% presets.forEach(function (preset) { %>
    <a class="chip-link" href="/relatorios?preset=<%= preset.key %><%= f.cliente ? '&cliente=' + f.cliente : '' %>"><%= preset.label %></a>
  <% }); %>
</div>

<section class="kpis report-kpis">
  <div class="card kpi"><span class="kpi-label">Total no período</span><strong class="kpi-number"><%= report.totals.total %></strong></div>
  <div class="card kpi alert-kpi"><span class="kpi-label">Abertos</span><strong class="kpi-number"><%= report.totals.abertos %></strong></div>
  <div class="card kpi ok-kpi"><span class="kpi-label">Concluídos no filtro</span><strong class="kpi-number"><%= report.totals.concluidos %></strong></div>
  <div class="card kpi"><span class="kpi-label">Rejeitados</span><strong class="kpi-number"><%= report.totals.rejeitados %></strong></div>
</section>

<div class="chart-grid">
  <section class="card chart-card">
    <h2>Distribuição dos jobs</h2>
    <div class="pizza-wrap">
      <svg class="grafico-pizza" viewBox="0 0 180 180" role="img" aria-label="Pizza: <%= report.totals.abertos %> abertos, <%= report.totals.concluidos %> concluídos, <%= report.totals.rejeitados %> rejeitados">
        <% report.pie.forEach(function (slice) { %>
          <path d="<%= slice.path %>" fill="<%= slice.color %>"><title><%= slice.label %>: <%= slice.value %> (<%= slice.percent %>%)</title></path>
        <% }); %>
        <circle cx="90" cy="90" r="34" fill="var(--surface)"></circle>
        <text class="pizza-total" x="90" y="86" text-anchor="middle"><%= report.totals.total %></text>
        <text class="pizza-caption" x="90" y="102" text-anchor="middle">jobs</text>
      </svg>
      <ul class="pie-legend">
        <% report.pie.forEach(function (slice) { %>
          <li><span class="legend-dot" style="background: <%= slice.color %>"></span><span><%= slice.label %></span><strong><%= slice.value %></strong><span class="muted"><%= slice.percent %>%</span></li>
        <% }); %>
      </ul>
    </div>
  </section>

  <section class="card chart-card">
    <h2>Criados × Concluídos</h2>
    <p class="muted small">Criados seguem a data de criação; concluídos seguem a data de conclusão.</p>
    <div class="grafico-barras" role="img" aria-label="Barras de jobs criados e concluídos por período">
      <% if (report.buckets.length === 0) { %>
        <p class="muted small empty-cell">Sem dados para o intervalo selecionado.</p>
      <% } %>
      <% report.buckets.forEach(function (b) { %>
        <div class="bar-group" title="<%= b.label %>: <%= b.criados %> criados, <%= b.concluidos %> concluídos">
          <div class="bar-pair">
            <div class="bar bar-criados" style="height: <%= b.criados && report.maxValue ? Math.max(2, Math.round((b.criados / report.maxValue) * 100)) : 0 %>%"></div>
            <div class="bar bar-concluidos" style="height: <%= b.concluidos && report.maxValue ? Math.max(2, Math.round((b.concluidos / report.maxValue) * 100)) : 0 %>%"></div>
          </div>
          <span class="bar-label"><%= b.label %></span>
        </div>
      <% }); %>
    </div>
    <div class="bar-legend">
      <span><i class="legend-swatch swatch-criados"></i>Criados</span>
      <span><i class="legend-swatch swatch-concluidos"></i>Concluídos</span>
    </div>
    <% if (report.truncated) { %><p class="muted small">Exibindo os últimos <%= report.buckets.length %> períodos. Refine o intervalo para ver todos.</p><% } %>
  </section>
</div>

<section class="card table-card">
  <h2>Resumo por período</h2>
  <% if (report.truncated) { %><p class="alert">Foram encontrados mais de <%= report.buckets.length %> períodos. Exibindo os <%= report.buckets.length %> mais recentes — use filtros mais específicos.</p><% } %>
  <div class="table-scroll">
    <table class="data-table">
      <thead>
        <tr>
          <th>Período</th><th>Criados</th><th>Concluídos</th><th>Abertos</th><th>Rejeitados</th><th>Total</th><th>Taxa de conclusão</th>
        </tr>
      </thead>
      <tbody>
        <% report.buckets.forEach(function (b) { %>
          <tr>
            <td><%= b.label %></td>
            <td><%= b.criados %></td>
            <td><%= b.concluidos %></td>
            <td><%= b.abertos %></td>
            <td><%= b.rejeitados %></td>
            <td><%= b.total %></td>
            <td><%= b.taxa === null ? '—' : b.taxa + '%' %></td>
          </tr>
        <% }); %>
        <% if (report.buckets.length === 0) { %>
          <tr><td colspan="7" class="muted empty-cell">Sem dados para o intervalo selecionado.</td></tr>
        <% } %>
      </tbody>
      <tfoot>
        <tr>
          <th>Total</th>
          <th><%= report.buckets.reduce(function (sum, b) { return sum + b.criados; }, 0) %></th>
          <th><%= report.buckets.reduce(function (sum, b) { return sum + b.concluidos; }, 0) %></th>
          <th><%= report.buckets.reduce(function (sum, b) { return sum + b.abertos; }, 0) %></th>
          <th><%= report.buckets.reduce(function (sum, b) { return sum + b.rejeitados; }, 0) %></th>
          <th><%= report.buckets.reduce(function (sum, b) { return sum + b.total; }, 0) %><%= report.truncated ? ' (exibido)' : '' %></th>
          <th>—</th>
        </tr>
      </tfoot>
    </table>
  </div>
</section>
<%- include('partials/bottom') %>
