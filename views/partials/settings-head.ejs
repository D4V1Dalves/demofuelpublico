<%
  const settingsTabs = [
    { href: '/configuracoes', label: 'Aparência' },
    { href: '/perfil', label: 'Conta' },
    { href: '/perfil/senha', label: 'Senha' },
  ];
  if (user.role === 'admin') {
    settingsTabs.push({ href: '/configuracoes/ia', label: 'IA das sugestões' });
    settingsTabs.push({ href: '/usuarios', label: 'Usuários' });
  }
%>
<div class="page-head settings-head">
  <h1 class="page-title">Configurações</h1>
</div>
<nav class="settings-tabs" aria-label="Seções das configurações">
  <% settingsTabs.forEach(function (tab) { %>
    <a class="settings-tab<%= path === tab.href ? ' is-active' : '' %>" href="<%= tab.href %>"<%= path === tab.href ? ' aria-current="page"' : '' %>><%= tab.label %></a>
  <% }); %>
</nav>
